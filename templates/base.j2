<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title %}{{ title }} - {% endif %}Core Linux</title>
    <link rel="stylesheet" href="static/style.css">
</head>
<body>
    <header>
        <h1><a href="./">Core Linux</a></h1>
        <input type="checkbox" id="menu" class="menu-toggle">
        <label for="menu" class="menu-button" aria-label="Menu">&#9776;</label>
        <nav>
            <a href="./">Home</a>
            <a href="https://github.com/lordhck/core">Source</a>
            <a href="https://pkgs.lordhck.com">Packages</a>
        </nav>
    </header>

    <main>
{{ content }}
    </main>

    <footer>
        <p>Core Linux &middot; MIT License &middot; Version: {% if version_url %}<a href="{{ version_url }}">{{ version }}</a>{% else %}{{ version }}{% endif %}</p>
    </footer>
</body>
</html>
